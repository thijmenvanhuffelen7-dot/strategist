# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# .env.local komt nooit in git.

# Nodig vanaf fase 2 (AI). Gratis key: https://console.groq.com → API Keys
GROQ_API_KEY=
# Standaardmodel wordt in fase 2 gekozen (zie https://console.groq.com/docs/models)
GROQ_MODEL=

# Optioneel: andere locatie voor de database (standaard prisma/strategist.db)
# DATABASE_URL=file:./prisma/strategist.db
