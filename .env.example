# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# .env.local komt nooit in git. Na wijzigen: app herstarten.

# AI (fase 2+). Gratis key: https://console.groq.com → API Keys
GROQ_API_KEY=
# Standaardmodel. Andere modellen: https://console.groq.com/docs/models (ook te kiezen in Instellingen)
GROQ_MODEL=openai/gpt-oss-120b

# Limieten van je Groq-abonnement (zie console.groq.com/settings/limits). De app plant verzoeken hieromheen.
AI_TOKENS_PER_MINUUT=8000
AI_TOKENS_PER_DAG=200000

# Optioneel: andere locatie voor de database (standaard prisma/strategist.db)
# DATABASE_URL=file:./prisma/strategist.db
