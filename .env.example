# Kopieer dit bestand naar .env.local en vul je eigen waarden in. .env.local komt nooit in git.
# Op Vercel zet je dezelfde waarden onder Settings → Environment Variables (de database-waarden zet Vercel zelf).

# Database (Neon via Vercel → Storage). Kopieer uit Vercel: Storage → je database → tabblad ".env.local".
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Wachtwoord om in te loggen (verplicht online; lokaal zonder wachtwoord staat de app open)
APP_WACHTWOORD=

# AI. Gratis key: https://console.groq.com → API Keys
GROQ_API_KEY=
# Standaardmodel. Andere modellen: https://console.groq.com/docs/models (ook te kiezen in Instellingen)
GROQ_MODEL=openai/gpt-oss-120b

# Model dat afbeeldingen kan lezen (screenshots in de Swipe File)
GROQ_VISIE_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Uploads: Vercel zet BLOB_READ_WRITE_TOKEN zelf als je Blob-opslag koppelt. Lokaal zonder token gaan uploads naar /uploads.
# BLOB_READ_WRITE_TOKEN=

# Limieten van je Groq-abonnement (zie console.groq.com/settings/limits)
AI_TOKENS_PER_MINUUT=8000
AI_TOKENS_PER_DAG=200000
